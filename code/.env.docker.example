# ============================================
# PaiNamNae Docker Compose Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.docker.example .env
# Then run:
#   docker compose up --build
# ============================================

# ── PostgreSQL ──────────────────────────────
POSTGRES_USER=painamnae
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=painamnae
DB_PORT=5432

# ── Backend (Express.js) ───────────────────
BACKEND_PORT=3000
JWT_SECRET=your_super_secret_jwt_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Maps (Backend)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_for_backend

# Extra CORS origins (comma-separated, optional)
CORS_ORIGIN=

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=123456789
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# ── Frontend (Nuxt.js) ─────────────────────
FRONTEND_PORT=3001
NUXT_PUBLIC_API_BASE=http://localhost:3000/api/
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_for_frontend
